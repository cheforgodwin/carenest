rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserDoc() ? currentUser().data.accountType : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isProvider() {
      // Only an administrator can promote an account to provider. That approval
      // is the authorization boundary; Firebase email verification is not a
      // second provider-approval system.
      return role() == 'provider';
    }

    function isCustomer() {
      return role() == 'customer';
    }

    function isRider() {
      return role() == 'rider';
    }

    function validRiderStatus(status) {
      return status in ['Accepted', 'Picked up', 'Delivered'];
    }

    function signedInCustomerWithoutProfile() {
      return signedIn()
        && !hasUserDoc()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validStatus(status) {
      return status in [
        'Pending',
        'Assigned',
        'In Progress',
        'Quality Check',
        'Out for Delivery',
        'Awaiting confirmation',
        'Completed',
        'Complaint',
        'Cancelled'
      ];
    }

    function validPaymentStatus(status) {
      return status in ['Pending', 'Submitted', 'Paid', 'Failed', 'Refunded'];
    }

    function validPayoutStatus(status) {
      return status in ['Unpaid', 'Ready', 'Paid', 'Partial', 'Held'];
    }

    function validPaymentMethod(method) {
      return method in ['Mobile Money', 'Fapshi'];
    }

    function validStepForStatus(status, step) {
      return (status == 'Pending' && step == 0)
        || (status == 'Assigned' && step == 1)
        || (status == 'In Progress' && step == 2)
        || (status == 'Quality Check' && step == 3)
        || (status == 'Out for Delivery' && step == 4)
        || (status == 'Awaiting confirmation' && step == 4)
        || (status == 'Completed' && step == 5)
        || (status == 'Complaint' && step == 2)
        || (status == 'Cancelled' && step == 0);
    }

    function validPrice(serviceType, itemSummary, serviceSpeed, amount) {
      return (
        serviceType == 'laundry'
        && (
          (itemSummary == 'Mixed clothes' && ((serviceSpeed == 'Normal' && amount == 3000) || (serviceSpeed == 'Express' && amount == 4500)))
          || (itemSummary == 'Shirts and trousers' && ((serviceSpeed == 'Normal' && amount == 2500) || (serviceSpeed == 'Express' && amount == 4000)))
          || (itemSummary == 'Beddings and towels' && ((serviceSpeed == 'Normal' && amount == 4500) || (serviceSpeed == 'Express' && amount == 6000)))
          || (itemSummary == 'Large family load' && ((serviceSpeed == 'Normal' && amount == 6500) || (serviceSpeed == 'Express' && amount == 8000)))
        )
      ) || (
        serviceType == 'cleaning'
        && (
          (itemSummary == 'Studio' && ((serviceSpeed == 'Standard' && amount == 5000) || (serviceSpeed == 'Deep Clean' && amount == 9000)))
          || (itemSummary == '1 Bedroom' && ((serviceSpeed == 'Standard' && amount == 7000) || (serviceSpeed == 'Deep Clean' && amount == 11000)))
          || (itemSummary == '2 Bedrooms' && ((serviceSpeed == 'Standard' && amount == 10000) || (serviceSpeed == 'Deep Clean' && amount == 14000)))
          || (itemSummary == '3+ Bedrooms' && ((serviceSpeed == 'Standard' && amount == 14000) || (serviceSpeed == 'Deep Clean' && amount == 18000)))
        )
      ) || (
        serviceType == 'delivery'
        && (
          (itemSummary == 'Groceries' && ((serviceSpeed == 'Standard' && amount == 2500) || (serviceSpeed == 'Priority' && amount == 3500)))
          || (itemSummary == 'Household essentials' && ((serviceSpeed == 'Standard' && amount == 3000) || (serviceSpeed == 'Priority' && amount == 4000)))
          || (itemSummary == 'Pharmacy' && ((serviceSpeed == 'Standard' && amount == 3500) || (serviceSpeed == 'Priority' && amount == 4500)))
          || (itemSummary == 'Custom errand' && ((serviceSpeed == 'Standard' && amount == 4500) || (serviceSpeed == 'Priority' && amount == 5500)))
        )
      );
    }

    function validMarketplaceOrder() {
      let listingId = request.resource.data.get('listingId', '');
      let listingPath = /databases/$(database)/documents/providerListings/$(listingId);
      let listing = get(listingPath).data;
      return request.resource.data.serviceType == 'marketplace'
        && listingId is string
        && exists(listingPath)
        && listing.active == true
        && request.resource.data.providerUid == listing.providerUid
        && request.resource.data.providerName == listing.providerName
        && request.resource.data.listingCategory == listing.category
        && request.resource.data.unitPrice == listing.price
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 50
        && request.resource.data.amount == listing.price * request.resource.data.quantity
        && (!listing.stockTracked || request.resource.data.quantity <= listing.stockQuantity);
    }
    match /users/{userId} {
      allow create: if (
          ownsUserDoc(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.accountType == 'customer'
          && request.resource.data.email == request.auth.token.email
        );

      allow get: if ownsUserDoc(userId) || isAdmin();

      allow list: if isAdmin();

      allow update: if isAdmin()
        || (
          ownsUserDoc(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'accountType',
            'uid',
            'email',
            'createdAt',
            'emailVerified',
            'emailVerifiedAt',
            'providerVerified',
            'providerVerifiedAt',
            'payoutPhoneVerified'
          ])
        )
        || (
          ownsUserDoc(userId)
          && request.auth.token.email_verified == true
          && request.resource.data.emailVerified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'emailVerified',
            'emailVerifiedAt',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /providerApplications/{applicationId} {
      allow create: if isCustomer()
        && applicationId == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.phone.matches('^\\+2376[0-9]{8}$')
        && request.resource.data.identityVerified == false
        && request.resource.data.payoutPhoneVerified == false
        && request.resource.data.status == 'Pending'
        && request.resource.data.role in ['provider', 'rider']
        && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('services', '').size() <= 240
        && request.resource.data.get('area', '').size() <= 240
        && request.resource.data.get('experience', '').size() <= 2000
        && request.resource.data.get('transportType', '').size() <= 120
        && request.resource.data.email == request.auth.token.email;

      allow get: if signedIn()
        && (isAdmin() || applicationId == request.auth.uid);

      allow list: if signedIn()
        && (isAdmin() || resource.data.userUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          signedIn()
          && applicationId == request.auth.uid
          && resource.data.userUid == request.auth.uid
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.status == 'Pending'
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'reviewerUid',
            'reviewedAt',
            'identityVerified',
            'payoutPhoneVerified',
            'verificationReviewedBy',
            'verificationReviewedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /providerListings/{listingId} {
      allow create: if isProvider()
        && request.resource.data.providerUid == request.auth.uid
        && request.resource.data.category in ['gas', 'water', 'essentials', 'laundry', 'cleaning', 'repairs']
        && request.resource.data.kind in ['product', 'service']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.price is int
        && request.resource.data.price >= 100
        && request.resource.data.unit is string
        && request.resource.data.serviceArea is string
        && request.resource.data.serviceArea.size() >= 2
        && request.resource.data.serviceArea.size() <= 240
        && request.resource.data.unit.size() <= 40
        && request.resource.data.get('turnaround', '').size() <= 120
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 12
        && request.resource.data.stockTracked is bool
        && request.resource.data.stockQuantity is int
        && request.resource.data.stockQuantity >= 0
        && request.resource.data.active is bool;

      allow get: if signedIn()
        && (resource.data.active == true || isAdmin() || (isProvider() && resource.data.providerUid == request.auth.uid));

      allow list: if signedIn()
        && (resource.data.active == true || isAdmin() || (isProvider() && resource.data.providerUid == request.auth.uid));

      allow update: if isAdmin()
        || (
          isProvider()
          && resource.data.providerUid == request.auth.uid
          && request.resource.data.providerUid == request.auth.uid
          && request.resource.data.category == resource.data.category
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'moderationStatus', 'moderationNote', 'reviewedBy', 'reviewedAt'
          ])
          && request.resource.data.price is int
          && request.resource.data.price >= 100
          && request.resource.data.stockQuantity is int
          && request.resource.data.stockQuantity >= 0
          && request.resource.data.options is list
          && request.resource.data.options.size() <= 12
        );

      allow delete: if isAdmin();
    }
    match /serviceRequests/{requestId} {
      allow create: if signedIn()
        && (
          isCustomer()
          || signedInCustomerWithoutProfile()
        )
        && request.resource.data.keys().hasAll([
          'customerUid',
          'customerEmail',
          'serviceType',
          'serviceSpeed',
          'itemSummary',
          'amount',
          'status',
          'currentStep',
          'paymentMethod',
          'paymentStatus'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.currentStep == 0
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.get('paymentReference', '') == ''
        && request.resource.data.get('paymentReceiptTransactionId', '') == ''
        && !request.resource.data.keys().hasAny(['paymentInitiationId', 'paymentInitiationState', 'paymentInitiationStartedAtMs', 'paymentInitiatedBy', 'paymentVerifiedAt', 'paymentVerifiedBy', 'paymentProviderStatus', 'paymentConfirmedAt', 'paidAt', 'paymentLastCheckedAtMs', 'providerAcceptedBy', 'providerAcceptedAt', 'riderUid', 'riderStatus', 'refundStatus', 'disputeStatus'])
        && !request.resource.data.keys().hasAny(['completionConfirmedBy', 'completionConfirmedAt', 'completionRequestedBy', 'completionRequestedAt', 'completedAt', 'deliveredAt'])
        && request.resource.data.get('customerName', '').size() <= 80
        && request.resource.data.get('customerPhone', '').size() <= 20
        && request.resource.data.get('address', '').size() <= 240
        && request.resource.data.get('note', '').size() <= 1000
        && validPaymentMethod(request.resource.data.paymentMethod)
        && (
          (
            request.resource.data.serviceType != 'marketplace'
            && validPrice(
              request.resource.data.serviceType,
              request.resource.data.itemSummary,
              request.resource.data.serviceSpeed,
              request.resource.data.amount
            )
            && !request.resource.data.keys().hasAny([
              'providerUid',
              'providerName',
              'providerEmail',
              'paidAt'
            ])
          )
          || validMarketplaceOrder()
        );

      allow get, list: if signedIn()
        && (
          isAdmin()
          || resource.data.get('customerUid', '') == request.auth.uid
          || (isProvider() && resource.data.get('providerUid', '') == request.auth.uid)
          || (isRider() && resource.data.get('riderUid', '') == request.auth.uid)
        );

      function verifiedPayment() {
        return resource.data.paymentStatus == 'Paid'
          && resource.data.get('paymentVerifiedAt', null) is timestamp
          && resource.data.get('paymentVerifiedBy', '') in ['fapshi-webhook', 'fapshi-poll'];
      }

      function adminWorkflow() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let before = resource.data.status;
        let after = request.resource.data.status;
        return (before == after
          || (after in ['Complaint', 'Cancelled'] && before != 'Completed')
          || (before == 'Pending' && after == 'Assigned' && verifiedPayment() && request.resource.data.get('providerUid', '') != '')
          || (before == 'Assigned' && after == 'Pending' && request.resource.data.get('providerUid', '') == ''))
          && (!changed.hasAny(['providerUid']) || (before in ['Pending', 'Assigned'] && (after == 'Pending' || verifiedPayment())))
          && (!changed.hasAny(['providerUid']) || request.resource.data.get('providerUid', '') == '' || get(/databases/$(database)/documents/users/$(request.resource.data.providerUid)).data.accountType == 'provider')
          && (!changed.hasAny(['riderUid', 'riderStatus']) || (
            verifiedPayment() && before == 'Out for Delivery' && resource.data.serviceType == 'delivery'
            && resource.data.get('riderUid', '') == '' && request.resource.data.get('riderUid', '') != ''
            && get(/databases/$(database)/documents/users/$(request.resource.data.riderUid)).data.accountType == 'rider'
            && request.resource.data.riderStatus == 'Accepted'
          ));
      }

      function providerWorkflow() {
        let before = resource.data.status;
        let after = request.resource.data.status;
        let accepting = (before == 'Pending' && after == 'Assigned') || (before == 'Assigned' && after == 'In Progress');
        return verifiedPayment() && (
          accepting
          || (before == 'In Progress' && after == 'Quality Check')
          || (before == 'Quality Check' && after == 'Out for Delivery')
          || (before in ['Quality Check', 'Out for Delivery'] && after == 'Awaiting confirmation' && resource.data.serviceType != 'delivery')
        ) && (!accepting || (request.resource.data.providerAcceptedBy == request.auth.uid && request.resource.data.providerAcceptedAt == request.time))
          && (accepting || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['providerAcceptedBy', 'providerAcceptedAt']));
      }

      function adminCanUpdateOrder() {
        return adminWorkflow()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'currentStep', 'updatedAt', 'providerUid', 'providerName', 'providerEmail', 'providerPhone',
            'providerPayoutMethod', 'providerPayoutPhone', 'assignedBy', 'assignedAt',
            'riderUid', 'riderName', 'riderPhone', 'riderStatus', 'riderAssignedAt',
            'payoutStatus', 'payoutNote', 'payoutSchedule', 'payoutReviewedBy', 'payoutReviewedAt', 'payoutHistory', 'payoutPaidAt', 'providerPayoutAmount',
            'refundStatus', 'refundRequestedBy', 'refundRequestedAt', 'refundNote', 'disputeStatus'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['refundStatus']) || (verifiedPayment() && request.resource.data.refundStatus == 'Requested' && request.resource.data.refundRequestedBy == request.auth.uid && request.resource.data.refundRequestedAt == request.time && request.resource.data.payoutStatus == 'Held'))
          && validStatus(request.resource.data.status)
          && validStepForStatus(request.resource.data.status, request.resource.data.currentStep)
          && validPaymentStatus(request.resource.data.paymentStatus)
          && (
            request.resource.data.paymentStatus == resource.data.paymentStatus
          )
          && (
            !('payoutStatus' in request.resource.data)
            || (
              validPayoutStatus(request.resource.data.payoutStatus)
              && (
                !(request.resource.data.payoutStatus in ['Ready', 'Paid', 'Partial'])
                || (
                  request.resource.data.status == 'Completed'
                  && verifiedPayment()
                  && request.resource.data.get('refundStatus', '') != 'Requested'
                  && request.resource.data.get('disputeStatus', '') != 'Open'
                  && resource.data.get('completionConfirmedBy', '') == resource.data.customerUid
                  && resource.data.get('completionConfirmedAt', null) is timestamp
                )
              )
            )
          )
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.customerEmail == resource.data.customerEmail
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.serviceType == resource.data.serviceType
          && request.resource.data.itemSummary == resource.data.itemSummary
          && request.resource.data.serviceSpeed == resource.data.serviceSpeed;
      }

      function providerCanUpdateOrder() {
        return providerWorkflow() && !(resource.data.status in ['Complaint', 'Cancelled', 'Completed', 'Awaiting confirmation'])
          && request.resource.data.status != 'Completed'
          && validStatus(request.resource.data.status)
          && validStepForStatus(request.resource.data.status, request.resource.data.currentStep)
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.customerEmail == resource.data.customerEmail
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.serviceType == resource.data.serviceType
          && request.resource.data.itemSummary == resource.data.itemSummary
          && request.resource.data.serviceSpeed == resource.data.serviceSpeed
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && (
            (
              resource.data.providerUid == request.auth.uid
              && (
                request.resource.data.status != 'Awaiting confirmation'
                || (
                  request.resource.data.completionProofText is string
                  && request.resource.data.completionProofText.size() >= 8
                  && request.resource.data.completionProofText.size() <= 1000
                  && request.resource.data.completionRequestedBy == request.auth.uid
                  && request.resource.data.completionRequestedAt == request.time
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'currentStep', 'completionProofText', 'completionRequestedBy', 'completionRequestedAt', 'providerAcceptedBy', 'providerAcceptedAt', 'updatedAt'
              ])
            )
          );
      }

      function customerCanUpdateOrder() {
        return resource.data.customerUid == request.auth.uid
          && request.resource.data.customerUid == resource.data.customerUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customerNote', 'updatedAt'
            ])
            || (
              verifiedPayment() && resource.data.status == 'Awaiting confirmation'
              && resource.data.get('completionConfirmedBy', '') == ''
              && request.resource.data.status == 'Completed'
              && request.resource.data.currentStep == 5
              && request.resource.data.completionConfirmedBy == request.auth.uid
              && request.resource.data.completionConfirmedAt == request.time
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'currentStep', 'completionConfirmedBy', 'completionConfirmedAt', 'completedAt', 'updatedAt'
              ])
            )
            || (
              request.resource.data.status == 'Complaint'
              && request.resource.data.currentStep == 2
              && request.resource.data.payoutStatus == 'Held'
              && request.resource.data.get('disputeStatus', 'Open') == 'Open'
              && request.resource.data.complaintText is string
              && request.resource.data.complaintText.size() >= 10
              && request.resource.data.complaintText.size() <= 2000
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'currentStep',
                'disputeStatus',
                'complaintText',
                'complaintSubmittedAt',
                'payoutStatus',
                'payoutNote',
                'updatedAt'
              ])
            )
          );
      }

      function riderCanUpdateOrder() {
        return verifiedPayment()
          && resource.data.status == 'Out for Delivery'
          && ((resource.data.riderStatus == 'Accepted' && request.resource.data.riderStatus == 'Picked up')
            || (resource.data.riderStatus == 'Picked up' && request.resource.data.riderStatus == 'Delivered'))
          && !(resource.data.status in ['Complaint', 'Cancelled', 'Completed', 'Awaiting confirmation'])
          && resource.data.serviceType == 'delivery'
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.customerEmail == resource.data.customerEmail
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.serviceType == resource.data.serviceType
          && request.resource.data.itemSummary == resource.data.itemSummary
          && request.resource.data.serviceSpeed == resource.data.serviceSpeed
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && (
              resource.data.get('riderUid', '') == request.auth.uid
              && request.resource.data.riderUid == request.auth.uid
              && validRiderStatus(request.resource.data.riderStatus)
              && (
                (
                  request.resource.data.riderStatus != 'Delivered'
                  && request.resource.data.status == resource.data.status
                  && request.resource.data.currentStep == resource.data.currentStep
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'riderStatus', 'updatedAt'
                  ])
                )
                || (
                  request.resource.data.riderStatus == 'Delivered'
                  && request.resource.data.status == 'Awaiting confirmation'
                  && request.resource.data.currentStep == 4
                  && request.resource.data.completionRequestedBy == request.auth.uid
                  && request.resource.data.completionRequestedAt == request.time
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'riderStatus', 'status', 'currentStep', 'deliveredAt', 'completionRequestedBy', 'completionRequestedAt', 'updatedAt'
                  ])
                )
              )
            );
      }

      function canUpdateOrder() {
        let accountRole = role();
        return accountRole == 'admin' ? adminCanUpdateOrder()
          : accountRole == 'provider' ? providerCanUpdateOrder()
          : accountRole == 'customer' ? customerCanUpdateOrder()
          : accountRole == 'rider' ? riderCanUpdateOrder()
          : false;
      }

      allow update: if signedIn() && canUpdateOrder();

      allow delete: if isAdmin();
    }

    match /paymentSmsReceipts/{receiptId} {
      allow create, update, delete: if isAdmin();
      allow get, list: if isAdmin();
    }
  }
}
